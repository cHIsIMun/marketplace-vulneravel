<!-- views/search.ejs -->
<% layout('layout', { title: 'Search Results', user: user }) %>

<h1 class="text-3xl font-bold mb-4">🔎 Search Results for "<%= query %>"</h1>

<% if (error) { %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
    <strong>Error:</strong> <%= error %>
  </div>
<% } %>

<% if (products.length === 0) { %>
  <p>No products found matching your search criteria.</p>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% products.forEach(product => { %>
      <div class="bg-white p-4 rounded shadow">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-48 object-cover mb-2 rounded">
        <h2 class="text-xl font-semibold"><%= product.name %></h2>
        <p class="text-gray-700">💲 <%= product.price %></p>
        <p class="text-sm text-gray-500">🏷️ <%= product.tags %></p>
        <a href="/product/<%= product.id %>" class="text-blue-500 mt-2 inline-block">🔍 View Details</a>
      </div>
    <% }) %>
  </div>
<% } %>
